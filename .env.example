# Copy to .env for local overrides. Never commit .env. Dev-only defaults below.
ARCHMIND_ENV=dev
ARCHMIND_DATABASE_URL=postgresql+psycopg://archmind:archmind@localhost:5432/archmind
ARCHMIND_REDIS_URL=redis://localhost:6379/0
ARCHMIND_S3_ENDPOINT=http://localhost:9000
ARCHMIND_S3_BUCKET=archmind
# ADR-006: mock is the default; a real provider needs its own key variable.
ARCHMIND_LLM_PROVIDER=mock
